filters:
  and:
    - type == "take"
properties:
  sources:
    displayName: 出处
  settled:
    displayName: 定了没
views:
  - type: table
    name: Takes
    order:
      - file.name
      - gist
      - settled
      - sources
      - tags
      - updated
  - type: table
    name: Open
    filters:
      and:
        - settled != true
    order:
      - file.name
      - gist
      - sources
      - updated

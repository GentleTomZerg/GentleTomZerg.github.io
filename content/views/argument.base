filters:
  and:
    - type == "argument"
properties:
  quotes_check:
    displayName: 引文核对
  sources:
    displayName: 出处
views:
  - type: table
    name: Arguments
    order:
      - file.name
      - gist
      - sources
      - tags
      - updated
      - quotes_check
  - type: table
    name: No quotes
    filters:
      and:
        - quotes_check == 0
    order:
      - file.name
      - gist
      - sources
      - updated

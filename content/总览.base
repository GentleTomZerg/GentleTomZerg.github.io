filters:
  and:
    - file.inFolder("wiki")
    - file.ext == "md"
properties:
  confidence:
    displayName: 掌握
  tested:
    displayName: 测试
  pass1:
    displayName: 通读
views:
  - type: table
    name: Concepts
    filters:
      and:
        - type == "concept"
    order:
      - file.name
      - confidence
      - tested
  - type: table
    name: 待测
    filters:
      and:
        - type == "concept"
        - confidence != "solid"
    order:
      - file.name
      - confidence
      - tested
  - type: table
    name: Summaries
    filters:
      and:
        - type == "summary"
    order:
      - file.name
      - pass1
  - type: list
    name: Entities
    filters:
      and:
        - type == "entity"
    order:
      - file.name
